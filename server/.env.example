# ─────────────────────────────────────────────────────────────
# DevLoop API — environment variables
# Copy this file to `.env` and fill in real values.
# The server runs WITHOUT most of these (degraded/mock mode) so
# you can develop the frontend immediately. Add them as you go.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — leave blank to run the API in "no-DB" mode (routes that
# need Mongo will return a clear 503 instead of crashing).
MONGODB_URI=

# Auth — CHANGE THESE in any real deployment.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# GitHub OAuth  (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Google OAuth  (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI — Google Gemini  (https://aistudio.google.com/apikey)
# Without a key, AI endpoints return a clearly-labelled mock analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Code execution — Judge0  (https://rapidapi.com/judge0-official/api/judge0-ce)
# Without a key, the run endpoint returns a simulated execution result.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
