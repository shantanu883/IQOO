# ─────────────────────────────────────────────────────────────
# DevLoop client — environment variables
# Copy to `.env` (or `.env.local`) to override defaults.
# ─────────────────────────────────────────────────────────────

# Demo mode: when "true" the app runs entirely on the in-browser
# mock API (rich seed data, no backend needed). Set to "false" to
# talk to the real Express server via /api.
VITE_DEMO_MODE=true

# Base URL for the API when NOT in demo mode.
VITE_API_URL=/api
